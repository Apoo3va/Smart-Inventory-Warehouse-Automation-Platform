            "index": 0
          }
        ]
      ]
    },
    "Format Error Details": {
      "main": [
        [
          {
            "node": "Append Error to Audit_Trail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append Error to Audit_Trail": {
      "main": [
        [
          {
            "node": "Slack Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
